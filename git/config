[core]
    autocrlf = input
    editor = vim

[init]
    defaultBranch = mainline

[apply]
    whitespace = fix

[alias]
    # Less typing is good.
    d = diff
    ds = diff --staged
    co = checkout
    br = branch
    ci = commit
    st = status
    rs = "restore --staged"
    # Rebasing
    r = !"r() { git rebase -i HEAD~$1; }; r"
    ri = "rebase -i"
    rc = "rebase --continue"
    # Always verbose tags.
    tags = tag -l
    # Pull and update submodules to their tracked branches.
    p = !git pull && git submodule update --remote
    # Pretty logs.
    lg = log --pretty=oneline --abbrev-commit --graph --decorate --all
    last = log -1 HEAD
    # NPM sucks
    al = add package-lock.json
    dh = diff HEAD~1

[merge]
    conflictstyle = zdiff3
    log = 100

[color]
    ui = auto

[push]
    default = simple

[credential]
    helper = cache

[advice]
    detachedHead = false

[pull]
    rebase = true

[fetch]
    prune = true
    pruneTags = true

[rebase]
    autoStash = true
    autoSquash = true

[commit]
    verbose = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram
    colorMoved = default

[column]
    ui = auto
